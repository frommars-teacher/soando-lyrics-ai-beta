{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soando-lyrics-suno-test",
  "main": "src/test-worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "services": [
    {
      "binding": "COACH",
      "service": "soando-lyrics-ai-beta"
    }
  ],
  "observability": {
    "enabled": false
  }
}
